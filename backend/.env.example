# Copia este archivo a .env y ajusta los valores para tu entorno.
# El binario lee estas variables del entorno del proceso (os.Getenv), asi que
# debes exportarlas antes de arrancar (o usar --env-file / EnvironmentFile
# segun como despliegues) — no se carga un .env automaticamente.

# Puerto donde escucha el servidor HTTP
PORT=8080

# Ruta del archivo SQLite. Se crea solo al arrancar (migraciones automaticas).
# Nunca apuntes esto a una ruta compartida con datos reales en un entorno de ejemplo.
DB_PATH=./app.db

# development | production
# En development, el flag -seed puede cargar datos ficticios de ejemplo.
# En production, el servidor sirve el frontend embebido y -seed se ignora.
APP_ENV=development
